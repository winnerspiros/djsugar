<?xml version="1.0" encoding="utf-8"?>
<MixxxMIDIPreset schemaVersion="1" mixxxVersion="2.5">
    <info>
        <name>Pioneer CDJ-400</name>
        <author>Mixxx Android</author>
        <description>Pioneer CDJ-400 in USB MIDI mode (SOURCE SELECT: PC). One or two units: each plays the deck of its MIDI channel, or the deck chosen in the settings. Messages from the manual of the CDJ-400.</description>
    </info>
    <settings>
        <group label="Deck">
            <option variable="deck" type="enum" label="Deck of this unit">
                <value label="By its MIDI channel (1 = deck 1, 2 = deck 2...)" default="true">auto</value>
                <value label="Deck 1">1</value>
                <value label="Deck 2">2</value>
                <value label="Deck 3">3</value>
                <value label="Deck 4">4</value>
                <description>
                    With two units: set MIDI channel 2 on the second one (UTILITY), or choose Deck 1 here for one unit and Deck 2 for the other.
                </description>
            </option>
            <option variable="jogMode" type="enum" label="Jog mode at start">
                <value label="Vinyl: touching the platter scratches" default="true">vinyl</value>
                <value label="CDJ: the platter bends the tempo">cdj</value>
            </option>
        </group>
    </settings>
