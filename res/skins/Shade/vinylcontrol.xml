<Template>
  <!-- VinylControl sub-widget -->
  <WidgetGroup>
    <BackPath>style/style_bg_vinylcontrol.webp</BackPath>
    <Size>21,82</Size>
    <Children>
      <PushButton>
        <TooltipId>vinylcontrol_status</TooltipId>
        <NumberStates>2</NumberStates>
        <State>
          <Number>0</Number>
          <Pressed>skin:/btn/btn_vinylcontrol.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol.webp</Unpressed>
        </State>
        <State>
          <Number>1</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_over.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_over.webp</Unpressed>
        </State>
        <Pos>1,21</Pos>
        <Connection>
          <ConfigKey>[Channel<Variable name="channum"/>],vinylcontrol_enabled</ConfigKey>
        </Connection>
      </PushButton>

      <PushButton>
        <TooltipId>vinylcontrol_status</TooltipId>
        <NumberStates>2</NumberStates>
        <State>
          <Number>0</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_passthrough.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_passthrough.webp</Unpressed>
        </State>
        <State>
          <Number>1</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_passthrough_over.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_passthrough_over.webp</Unpressed>
        </State>
        <Pos>1,1</Pos>
        <Connection>
          <ConfigKey>[Channel<Variable name="channum"/>],passthrough</ConfigKey>
        </Connection>
      </PushButton>

      <!--
      **********************************************
      Vinyl- Status
      // Vinyl status indicators are inside the decks WidgetGroups
      **********************************************
      -->

      **********************************************
      Vinyl- Control Mode
      **********************************************

      <PushButton>
        <TooltipId>vinylcontrol_mode</TooltipId>
        <NumberStates>3</NumberStates>
        <State>
          <Number>0</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_abs.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_abs.webp</Unpressed>
        </State>
        <State>
          <Number>1</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_rel.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_rel.webp</Unpressed>
        </State>
        <State>
          <Number>2</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_const.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_const.webp</Unpressed>
        </State>
        <Pos>1,41</Pos>
        <Connection>
          <ConfigKey>[Channel<Variable name="channum"/>],vinylcontrol_mode</ConfigKey>
        </Connection>
      </PushButton>

      <!--
      **********************************************
      Vinyl- Cueing Mode
      **********************************************
      -->

      <PushButton>
        <TooltipId>vinylcontrol_cueing</TooltipId>
        <NumberStates>3</NumberStates>
        <State>
          <Number>0</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_cue_off.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_cue_off.webp</Unpressed>
        </State>
        <State>
          <Number>1</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_cue_on.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_cue_on.webp</Unpressed>
        </State>
        <State>
          <Number>2</Number>
          <Pressed>skin:/btn/btn_vinylcontrol_cue_hot.webp</Pressed>
          <Unpressed>skin:/btn/btn_vinylcontrol_cue_hot.webp</Unpressed>
        </State>
        <Pos>1,62</Pos>
        <Connection>
          <ConfigKey>[Channel<Variable name="channum"/>],vinylcontrol_cueing</ConfigKey>
        </Connection>
      </PushButton>

    </Children>
    <Connection>
      <ConfigKey>[Skin],show_vinylcontrol</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
