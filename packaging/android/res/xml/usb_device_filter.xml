<?xml version="1.0" encoding="utf-8"?>
<!-- USB device filter for DJ controllers -->
<!-- Pioneer DJ / AlphaTheta: VID=0x2B73 = 11123 -->
<resources>
    <!-- DDJ-FLX4 main audio/MIDI: PID 0x0046 = 70 -->
    <usb-device vendor-id="11123" product-id="70" />
    <!-- DDJ-FLX4 BLE chip: PID 0x0045 = 69 -->
    <usb-device vendor-id="11123" product-id="69" />
    <!-- DDJ-400: PID 0x0043 = 67 -->
    <usb-device vendor-id="11123" product-id="67" />
    <!-- DDJ-FLX6: PID 0x0049 = 73 -->
    <usb-device vendor-id="11123" product-id="73" />
    <!-- DDJ-800: PID 0x004A = 74 -->
    <usb-device vendor-id="11123" product-id="74" />
    <!-- Generic MIDI streaming: class 1 (Audio), subclass 3 (MIDI) -->
    <usb-device class="1" subclass="3" />
    <!-- Generic HID: class 3 -->
    <usb-device class="3" />
</resources>
